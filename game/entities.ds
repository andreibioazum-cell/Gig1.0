// entities — игровые объекты
// Punch — событие удара: точка, направление и счётчик выстрела для сети
object Player
num x=0, y=0, size=30, angle=0, hp=10, max_hp=10
end
object Enemy
// state: 0 = сближение/стрейф, 1 = замах, 2 = удар, 3 = отход, 4 = уклонение
// Цифры бота равны игроку: hp 10, урон 1, цикл атаки 0.3 с. Бот не «толще»
// и не «сильнее» игрока — он играет как живой: держит дистанцию и уклоняется.
// dodge_cd — перезарядка уклонения, think — пауза-передышка между заходами.
// px/py/pvx/pvy/seen — «зрение» бота: последняя увиденная позиция игрока и
// оценка его скорости (по ней бот упреждает удар и перехватывает движение).
// flank — таймер смены стороны обхода.
// mvx/mvy — фактическая скорость бота в ЭТОМ кадре (по ней спрайт
// разворачивается в сторону движения); svx/svy — сглаженная скорость обхода,
// живёт между кадрами, чтобы бой не дёргался при смене направления.
num x=0, y=0, size=25, hp=10, max_hp=10, angle=0, state=0, state_time=0, cooldown=0, hit=0, strafe=1, dodge_cd=0, think=0, px=0, py=0, pvx=0, pvy=0, seen=0, flank=0, mvx=0, mvy=0, svx=0, svy=0
end
object Punch
// shot — растущий номер удара; active/hit нужны для текущего окна урона.
num x=0, y=0, dx=0, dy=0, active=0, shot=0, hit=0
end
Player player=new Player()
Enemy enemy=new Enemy()
Punch punch=new Punch()
// punch_cd — кулдаун между ударами, aim_a — прозрачность серого хитбокса (0..1)
// aim_tx/aim_ty — точка упреждения бота (куда он целится с учётом скорости игрока)
num aim_tx=0, aim_ty=0
num finished=0, atk_x=0, atk_y=0, joy_id=-1, aim_id=-1, punch_left=0, punch_cd=0, aim_a=0
arr remotes=arr_new(), remote_punches=arr_new()
