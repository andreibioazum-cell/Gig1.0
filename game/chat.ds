num chat_open=0
str chat_input=""
// Полноэкранный онлайн-чат: без рамок и отступов, сообщения на весь экран.
// Системная клавиатура открывается только по нажатию на поле ввода.
// Старые сообщения, которые уже не влезают на экран, удаляются сами.

function chat_button str label, num x, num y, num w, num h
roundrect x,y,w,h,20,0x5F10A0
text_in_box label,x,y,w,h,0xFFFFFF,0.5
end
function chat_close_x
return screen_w-btn_w-16
end
function chat_msg_top
return back_y+btn_h+12
end
function chat_input_y
return screen_h-72
end
function chat_visible_limit
num ly=chat_msg_top(), iy=chat_input_y(), lh=iy-ly-12, line_h=28
num maxl=floor(lh/line_h); if maxl<1; maxl=1; end
return maxl
end
function chat_sync_input
// Всегда берём актуальный буфер клавиатуры. Раньше сравнение raw/chat_input
// могло оставить поле пустым, если указатель на строку уже не совпадал с
// тем, что рисует игра, хотя символы в IME уже были.
chat_input=keyboard_get_text()
end
function chat_send
chat_sync_input
if str_len(chat_input)==0; return; end
net_chat_send chat_input; ds_log "chat: %s",chat_input
chat_input=""; keyboard_clear
net_chat_trim chat_visible_limit()
end
function chat_update
// Ввод обрабатываем в update, а не в draw: иначе Enter и текст зависят от кадра.
if game_state!=5||chat_open==0; return; end
if keyboard_visible()==1; chat_sync_input; end
if keyboard_enter_pressed()==1; chat_send; end
if net_chat_count()>chat_visible_limit(); net_chat_trim chat_visible_limit(); end
end
function draw_chat
if game_state!=5; return; end
if chat_open==0
// В закрытом состоянии видна только кнопка: сообщения не просвечивают поверх игры.
button tr_chat(),16,150,140,48
return
end
// Тупо на весь экран: без внутренней панели и полей по 20px.
rect 0,0,screen_w,screen_h,0xFF1E1E2F
num cx=chat_close_x()
text_in_box tr_online_chat(),16,back_y,cx-32,btn_h,0xFFFFFF,1
button tr_close(),cx,back_y,btn_w,btn_h
num lx=16, lw=screen_w-32, iy=chat_input_y(), ih=52, ly=chat_msg_top(), line_h=28
num maxl=chat_visible_limit()
if net_chat_count()>maxl; net_chat_trim maxl; end
num total=net_chat_count(), start=total-maxl; if start<0; start=0; end
if total==0
text_scaled tr_no_messages(),lx,ly,0x8888AA,0.5
else
num idx=start, yy=ly
loop idx<total
if yy+line_h>iy-8; idx=total
else
// Для новых сообщений здесь ник, для старых — короткий технический uid.
str who=net_chat_uid(idx)
str line=who+": "+net_chat_text(idx)
if is_admin_nick(who)==1
// Сообщения администраторов помечаются золотой меткой перед ником.
str tag="["+tr_admin()+"] "
num tw=text_ink_width(tag)*0.5
text_scaled tag,lx,yy,0xFFD54A,0.5
text_scaled line,lx+tw,yy,0xE0E0FF,0.5
else
text_scaled line,lx,yy,0xE0E0FF,0.5
end
yy=yy+line_h; idx=idx+1
end
end
end
roundrect lx,iy,lw-122,ih,10,0xFF2A2A40
chat_sync_input
str shown=chat_input
if keyboard_visible()==1; shown=chat_input+"|"; end
if str_len(chat_input)==0&&keyboard_visible()==0; text_in_field tr_type_message(),lx+10,iy,ih,0x666688,0.55
else if str_len(shown)==0; text_in_field "|",lx+10,iy,ih,0xFFFFFF,0.55
else; text_in_field shown,lx+10,iy,ih,0xFFFFFF,0.55; end
chat_button tr_send(),lx+lw-112,iy,112,ih
end
function chat_hit num x, num y, num bx, num by, num bw, num bh
if x>=bx&&x<=bx+bw&&y>=by&&y<=by+bh; return 1; end; return 0
end
function touch_chat num x, num y, num action
if action!=0; return 0; end
if chat_open==0
if chat_hit(x,y,16,150,140,48)==1; chat_open=1; keyboard_hide; return 1; end
return 0
end
if chat_hit(x,y,chat_close_x(),back_y,btn_w,btn_h)==1; chat_open=0; keyboard_hide; return 1; end
num lx=16, lw=screen_w-32, iy=chat_input_y(), ih=52
if chat_hit(x,y,lx,iy,lw-122,ih)==1
// Клавиатура открывается только явным тапом по полю.
if keyboard_visible()==0; keyboard_show; end
return 1
end
if chat_hit(x,y,lx+lw-112,iy,112,ih)==1; chat_send; keyboard_hide; return 1; end
// Тап в любую другую точку закрывает клавиатуру и не возвращает фокус полю.
keyboard_hide
return 1
end
