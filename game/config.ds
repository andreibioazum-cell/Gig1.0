// config.ds — global game constants
//
// All gameplay numbers and tunable parameters live here so the rest of the
// scripts stay focused on logic. Keep tunable values grouped by topic.
//
// DimScript note: the loader is line-based; every `num`/`str` declaration
// must fit on a single line (one logical line per `type name = value`).
// The compiler splits each source line on `;` so several declarations can
// share a line, but the whole block cannot wrap across source lines.

// ---------------------------------------------------------------------------
// Player and shared combat constants
// ---------------------------------------------------------------------------
// The player and the solo bot share the same physical size and HP, so the
// visible sprite lines up with the collision circle. The bot matches the
// player on numbers (damage 1, HP 10, same punch reach/width) but is a bit
// faster (windup 0.07 + punch 0.16) and uses a random cooldown in
// enemy_cooldown_min..max, so the fight never settles into a robotic rhythm.
// The bot's edge is its behavior, not its stats: it holds distance, retreats
// after trades and dodges the player's punch like a real opponent.
num game_state=0
num language=0
num t_dir=0
num t_target=0
num t_fade=0
num transition_duration=0.15
num punch_time=0.2
num punch_cooldown=0.3
num punch_reach=104
num punch_width=104
num punch_damage=1
num joy_speed=192
num bot_speed=170
num bot_strafe_speed=96
num bot_dodge_speed=330
num btn_w=280
num btn_h=64
num back_y=32
num online_ready=0
num max_players=4
num pi=3.1415926535
num cube_scale=1
num player_scale=1.8
num enemy_scale=1.8
num aim_fade_out=0.1
num aim_max_alpha=102

// ---------------------------------------------------------------------------
// Online replication layout
// ---------------------------------------------------------------------------
// `remotes` holds 11 numbers per slot and `remote_punches` holds 6. We
// interpolate the visible position toward the latest network snapshot each
// frame, but a large jump is treated as a teleport and applied instantly.
// remotes fields: present, x, y, angle, hp, alive, punch, netx, nety,
//                 netangle, class.
num remote_fields=11
num punch_fields=6
num remote_smooth=14
num remote_snap=220

// ---------------------------------------------------------------------------
// Bot combat tuning
// ---------------------------------------------------------------------------
// dodge_time/cooldown — dodge window and rearm delay for avoiding the
//   player's punch.
// think_min/max — random pause between approaches; the bot falls back past
//   the player's reach and strafes instead of standing in a hit.
// cooldown_min/max — randomized bot punch cooldown: a fresh value in range
//   every time, but never faster than cooldown_min (0.1 s).
num enemy_min_distance=70
num enemy_punch_reach=104
num enemy_punch_width=104
num enemy_windup=0.07
num enemy_lock_time=0.04
num enemy_punch_time=0.16
num enemy_recovery=0.05
num enemy_cooldown_min=0.09
num enemy_cooldown_max=0.26
num enemy_damage=1
num enemy_first_delay=0.45
num enemy_dodge_time=0.2
num enemy_dodge_cooldown=0.6
num enemy_reaction=0.06
num enemy_think_min=0.04
num enemy_think_max=0.12

// ---------------------------------------------------------------------------
// Bot "brain" tuning
// ---------------------------------------------------------------------------
// lead        — how far ahead (seconds) the bot predicts the player for its
//               punch (windup + half the active window).
// hit_margin  — slack on reach so the punch is guaranteed to land.
// close_gain  — how aggressively the bot closes to the desired distance.
// flank_time  — how often the bot re-chooses which side to flank around.
// still_speed — below this player speed the bot considers the player "still".
// punish_react— reaction delay before the bot punishes a missed punch.
num enemy_lead=0.15
num enemy_hit_margin=12
num enemy_close_gain=4.5
num enemy_flank_time=0.9
num enemy_still_speed=25
num enemy_punish_react=0.05

// ---------------------------------------------------------------------------
// Bot motion smoothing
// ---------------------------------------------------------------------------
// move_smooth — how fast the strafe velocity lerps toward the new target.
//               Removes the jolt when the bot switches flank direction.
// face_speed  — how fast the sprite turns toward its movement direction.
// Both are fractions per second for the lerp.
num enemy_move_smooth=18
num enemy_face_speed=14

// ---------------------------------------------------------------------------
// Nick / login screen state
// ---------------------------------------------------------------------------
// The online screen only asks for a nick, no password or registration.
// login_field   — 1 while the nick field is focused (opened on enter).
// login_status  — 0 idle, 5 invalid nick.
// login_after   — where to go after the nick is accepted (0 lobby, 5 online).
num login_field=0
num login_status=0
num login_after=0

// Layout offsets for the nick screen. login_ox/login_oy shift the whole
// block, login_fh is the input field height, login_lab is the gap between
// the field and the "Nick" label above it (larger = label sits higher),
// login_lab_ox nudges that label rightward.
num login_ox=10
num login_oy=-26
num login_fh=54
num login_lab=40
num login_lab_ox=16

// Asset file names. Strings kept in one place so assets can be renamed here.
str GRASS="grass.png"
str ORDINARY_TEX="ordinary.png"
str PUNCH_TEX="ordinary_punch.png"
str AZUM_TEX="azum.png"
str AZUM_PUNCH_TEX="azum_punch.png"
str FIREBASE="https://cubicbattleserver-19ae2-default-rtdb.firebaseio.com"
str ROOM="main"
str login_nick=""

// ---------------------------------------------------------------------------
// Disco event (from Firebase)
// ---------------------------------------------------------------------------
// event_mode — 1 means the "disco" event is live (everything flashes).
// disco_safe — 1 means the epilepsy-safe mode is on (flashing is suppressed).
// disco_t    — running timer for the color pulse animation.
num event_mode=0
num disco_safe=0
num disco_t=0

// ---------------------------------------------------------------------------
// Classes and progression
// ---------------------------------------------------------------------------
// player_class  — 0 Ordinary, 1 Azum (one self-revive per match).
// azum_revived  — already burned the revive this match.
// revive_prot   — short invulnerability window after reviving. There is no
//                 on-screen flash: Azum simply stands up at a random spot.
num player_class=0
num azum_revived=0
num revive_prot=0

// Currency: cup_win is awarded on a win, azum_cost unlocks the Azum class
// permanently. class_msg_t shows a "need 50 cups" hint for a few seconds.
num cups=0
num azum_owned=0
num cup_win=5
num azum_cost=50
num cups_awarded=0
num match_seen_foe=0
num class_msg_t=0

// ---------------------------------------------------------------------------
// Level / damage absorb
// ---------------------------------------------------------------------------
// Each level adds 10% damage absorption (lvl 1 = 10%, lvl 5 = 50%).
num player_level=1
num max_level=5
