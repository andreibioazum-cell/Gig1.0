// config — все глобальные константы игры, строки через запятую
// Игрок и одиночный бот одного размера; физический размер совпадает с видимым спрайтом.
// Бот равен игроку по цифрам: урон enemy_damage=punch_damage, хитбокс удара
// enemy_punch_reach/width = punch_reach/width, HP 10 как у игрока. Бьёт он
// чуть быстрее игрока (замах 0.07 + удар 0.16) и с рандомной перезарядкой
// enemy_cooldown_min..max, чтобы ритм боя не был предсказуемым. Сила бота — не в
// цифрах, а в поведении: он держит дистанцию, отходит после размена и
// уклоняется от удара игрока (dodge), как живой соперник.
num game_state=0, language=0, t_dir=0, t_target=0, t_fade=0, transition_duration=0.15, punch_time=0.2, punch_cooldown=0.3, punch_reach=104, punch_width=104, punch_damage=1, joy_speed=192, bot_speed=170, bot_strafe_speed=96, bot_dodge_speed=330, btn_w=280, btn_h=64, back_y=32, online_ready=0, max_players=4, pi=3.1415926535, console_scroll=0, cube_scale=1, player_scale=1.8, enemy_scale=1.8, aim_fade_out=0.1, aim_max_alpha=102
// Онлайн: в remotes по 10 чисел, в remote_punches по 6. Координаты соперника
// плавно догоняют сетевую цель; большой скачок считается телепортом.
num remote_fields=10, punch_fields=6, remote_smooth=14, remote_snap=220
// Поведение бота: enemy_dodge_time/cooldown — окно и перезарядка
// уклонения от удара игрока;
// enemy_think_min/max — случайная пауза между заходами (бот отходит за
// дальность удара игрока и стрейфит, вместо того чтобы стоять под ударами).
// enemy_cooldown_min/max — случайная перезарядка удара бота: каждый раз новое
// значение в диапазоне, но не быстрее enemy_cooldown_min (0.1 с).
num enemy_min_distance=70, enemy_punch_reach=104, enemy_punch_width=104, enemy_windup=0.07, enemy_lock_time=0.04, enemy_punch_time=0.16, enemy_recovery=0.05, enemy_cooldown_min=0.09, enemy_cooldown_max=0.26, enemy_damage=1, enemy_first_delay=0.45, enemy_dodge_time=0.2, enemy_dodge_cooldown=0.6, enemy_reaction=0.06, enemy_think_min=0.04, enemy_think_max=0.12
// Новый «мозг» бота: enemy_lead — на сколько секунд вперёд он упреждает удар
// (замах + половина активного окна), enemy_hit_margin — запас по дальности,
// чтобы удар гарантированно доставал, enemy_close_gain — резкость подхода к
// нужной дистанции, enemy_flank_time — как часто он перезаходит с фланга,
// enemy_still_speed — порог «игрок стоит», enemy_punish_react — задержка,
// с которой бот замечает промах игрока и идёт наказывать.
num enemy_lead=0.15, enemy_hit_margin=12, enemy_close_gain=4.5, enemy_flank_time=0.9, enemy_still_speed=25, enemy_punish_react=0.05
// Плавность бота: enemy_move_smooth — насколько быстро скорость обхода
// подтягивается к новой цели (убирает рывки при смене стороны), enemy_face_speed —
// скорость разворота спрайта к направлению движения. Оба — доля в секунду для lerp.
num enemy_move_smooth=18, enemy_face_speed=14
// Экран ника: вход в онлайн спрашивает только ник, без пароля и регистрации.
// login_field — 1, когда поле ника в фокусе (открывается сразу), login_status: 0=идл, 5=неверный ник,
// login_after — куда перейти после ника (0=лобби, 5=онлайн).
num login_field=0, login_status=0, login_after=0
// Раскладка экрана ника: login_ox/login_oy — сдвиг блока, login_fh — высота
// поля ввода, login_lab — отступ подписи «Ник» над полем (больше = выше),
// login_lab_ox — сдвиг этой подписи вправо.
num login_ox=10, login_oy=-26, login_fh=54, login_lab=40, login_lab_ox=16
str GRASS="grass.png", ORDINARY_TEX="ordinary.png", PUNCH_TEX="ordinary_punch.png", AZUM_TEX="azum.png", AZUM_PUNCH_TEX="azum_punch.png", COLUMN="Column.png", FIREBASE="https://cubicbattleserver-19ae2-default-rtdb.firebaseio.com", ROOM="main", login_nick=""
// Диско-ивент из Firebase: event_mode=1 — «диско» включено (всё мигает),
// disco_safe=1 — безопасный для эпилептиков режим (мигание выключено),
// disco_t — таймер для плавной смены цветов.
num event_mode=0, disco_safe=0, disco_t=0
// Классы: player_class 0 = Обычный, 1 = Азум (одно возрождение за бой).
// azum_revived — уже тратили воскрешение, revive_flash/revive_prot — вспышка и неуязвимость.
num player_class=0, azum_revived=0, revive_flash=0, revive_prot=0
