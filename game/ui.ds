// ui — кнопки и HP бары
function hud_bar num bx, num by, num w, num h, num cur, num max, col color, num from_right
roundrect bx,by,w,h,h/2,0xDD171923; num shown=cur; if shown<0; shown=0; end; num fill_w=(w-8)*shown/max
if fill_w>0; if from_right==1; roundrect bx+w-4-fill_w,by+4,fill_w,h-8,(h-8)/2,color; else; roundrect bx+4,by+4,fill_w,h-8,(h-8)/2,color; end; end
end
function draw_back
button tr_back(),(screen_w-btn_w)/2,back_y,btn_w,btn_h
end
function back_hit num x, num y
num bx=(screen_w-btn_w)/2
if x>=bx-12&&x<=bx+btn_w+12&&y>=back_y-8&&y<=back_y+btn_h+8; return 1; end; return 0
end
function ctext str s, num y, col color
text s,(screen_w-text_ink_width(s))/2,y,color
end
function text_in_box str label, num x, num y, num w, num h, col color, num scale
// Центруем реальные видимые границы глифов, а не условную базовую линию шрифта.
// Небольшая оптическая поправка вниз не даёт Play/Играть и подсказкам «уезжать» вверх.
num tw=text_ink_width(label)*scale, th=text_ink_height(label)*scale, tt=text_ink_top(label)*scale
text_scaled label,x+(w-tw)/2,y+(h-th)/2-tt+1.5,color,scale
end
function text_in_field str label, num x, num y, num h, col color, num scale
num th=text_ink_height(label)*scale, tt=text_ink_top(label)*scale
text_scaled label,x,y+(h-th)/2-tt+1.5,color,scale
end
function text_fit_scale str label, num w, num scale
// Подгоняем масштаб текста под ширину: длинная подпись («Купить за 100
// леденцов») больше не вылезает за края кнопки.
num tw=text_ink_width(label)*scale
if tw<=w||tw<=0; return scale; end
return w*scale/tw
end
function button str label, num x, num y, num w, num h
roundrect x,y,w,h,20,0x5F10A0; text_in_box label,x,y,w,h,0xFFFFFF,text_fit_scale(label,w-28,1)
end
function button_scaled str label, num x, num y, num w, num h, num scale
// Та же кнопка, но текст меньше — для длинных подписей, чтобы не вылезали за рамки.
roundrect x,y,w,h,20,0x5F10A0; text_in_box label,x,y,w,h,0xFFFFFF,text_fit_scale(label,w-24,scale)
end
