// ui — кнопки и HP бары
function draw_back
button tr_back(),(screen_w-btn_w)/2,back_y,btn_w,btn_h
end
function back_hit num x, num y
num bx=(screen_w-btn_w)/2
if x>=bx-12&&x<=bx+btn_w+12&&y>=back_y-8&&y<=back_y+btn_h+8; return 1; end; return 0
end
function ctext str s, num y, col color
// -text_ink_top: у кириллицы/японского глифы выше латиницы, без компенсации
// текст «уезжает вверх» — верх чернил всегда ровно на y
text s,(screen_w-text_ink_width(s))/2,y-text_ink_top(s),color
end
function text_in_box str s, num x, num y, num h, col color, num sc
// текст, вертикально центрированный в полосе высотой h: центрируем полосу
// «верх чернил..базовая линия», хвосты (y, р, g) свисают вниз — ничего не
// «уезжает вверх» ни у латиницы, ни у кириллицы, ни у японского
num asc=text_ink_height("S")*sc, top=text_ink_top(s)*sc, band=asc-top
text_scaled s,x,y+(h-band)/2-top,color,sc
end
function button str label, num x, num y, num w, num h
roundrect x,y,w,h,20,0x5F10A0
text_in_box label,x+(w-text_ink_width(label))/2,y,h,0xFFFFFF,1
end
function hud_bar num bx, num by, num w, num h, num cur, num max, col color, num from_right
roundrect bx,by,w,h,h/2,0xDD171923; num shown=cur; if shown<0; shown=0; end; num fill_w=(w-8)*shown/max
if fill_w>0; if from_right==1; roundrect bx+w-4-fill_w,by+4,fill_w,h-8,(h-8)/2,color; else; roundrect bx+4,by+4,fill_w,h-8,(h-8)/2,color; end; end
end
