// ui.ds — buttons, bars, text helpers
//
// Tiny reusable drawing helpers shared across screens. Keep this file
// dependency-free: it imports nothing and exports only the helpers used
// by lobby / settings / in-game HUD.

// ---------------------------------------------------------------------------
// hud_bar — health / progress bar
// ---------------------------------------------------------------------------
// from_right — 0 fills from the left (player), 1 fills from the right
//              (enemy) so the bar shrinks toward the side that lost HP.
function hud_bar num bx, num by, num w, num h, num cur, num max, col color, num from_right
    roundrect bx,by,w,h,h/2,0xDD171923
    num shown=cur
    if shown<0
        shown=0
    end
    num fill_w=(w-8)*shown/max
    if fill_w>0
        if from_right==1
            roundrect bx+w-4-fill_w,by+4,fill_w,h-8,(h-8)/2,color
        else
            roundrect bx+4,by+4,fill_w,h-8,(h-8)/2,color
        end
    end
end

// ---------------------------------------------------------------------------
// draw_back — the standard "Back" button at the top of most sub-screens
// ---------------------------------------------------------------------------
function draw_back
    button tr_back(),(screen_w-btn_w)/2,back_y,btn_w,btn_h
end

// Hit test for the back button. A small (+/- 12 px) slop on each side makes
// the button easier to tap with a thumb.
function back_hit num x, num y
    num bx=(screen_w-btn_w)/2
    if x>=bx-12&&x<=bx+btn_w+12&&y>=back_y-8&&y<=back_y+btn_h+8
        return 1
    end
    return 0
end

// ---------------------------------------------------------------------------
// ctext — horizontally centered text on the X axis
// ---------------------------------------------------------------------------
function ctext str s, num y, col color
    text s,(screen_w-text_ink_width(s))/2,y,color
end

// ---------------------------------------------------------------------------
// text_in_box — text centered both axes inside a rect
// ---------------------------------------------------------------------------
// We center against the actual visible glyph bounds (text_ink_width/height/
// top), not the font's baseline. A small +1.5 nudge keeps short buttons
// from looking like they sit too high in their pill.
function text_in_box str label, num x, num y, num w, num h, col color, num scale
    num tw=text_ink_width(label)*scale
    num th=text_ink_height(label)*scale
    num tt=text_ink_top(label)*scale
    text_scaled label,x+(w-tw)/2,y+(h-th)/2-tt+1.5,color,scale
end

// ---------------------------------------------------------------------------
// text_in_field — text vertically centered in a tall field, no X centering
// ---------------------------------------------------------------------------
function text_in_field str label, num x, num y, num h, col color, num scale
    num th=text_ink_height(label)*scale
    num tt=text_ink_top(label)*scale
    text_scaled label,x,y+(h-th)/2-tt+1.5,color,scale
end

// ---------------------------------------------------------------------------
// button — pill-shaped button with 1.0-scale centered label
// ---------------------------------------------------------------------------
function button str label, num x, num y, num w, num h
    roundrect x,y,w,h,20,0x5F10A0
    text_in_box label,x,y,w,h,0xFFFFFF,1
end

// Same as button() but allows shrinking the text for long captions so they
// stay inside the pill instead of overflowing.
function button_scaled str label, num x, num y, num w, num h, num scale
    roundrect x,y,w,h,20,0x5F10A0
    text_in_box label,x,y,w,h,0xFFFFFF,scale
end
