// locale.ds — интерфейс игры на английском, русском и японском.
// language: 0 = English, 1 = Русский, 2 = 日本語.

function tr_play
if language==1; return "Играть"; else if language==2; return "遊ぶ"; end; return "Play"
end
function tr_settings
if language==1; return "Настройки"; else if language==2; return "設定"; end; return "Settings"
end
function tr_solo
if language==1; return "Соло"; else if language==2; return "ソロ"; end; return "Solo"
end
function tr_online
if language==1; return "Онлайн"; else if language==2; return "オンライン"; end; return "Online"
end
function tr_console
if language==1; return "Консоль"; else if language==2; return "コンソール"; end; return "Console"
end
function tr_up
if language==1; return "Вверх"; else if language==2; return "上へ"; end; return "Up"
end
function tr_down
if language==1; return "Вниз"; else if language==2; return "下へ"; end; return "Down"
end
function tr_clear
if language==1; return "Очистить"; else if language==2; return "消去"; end; return "Clear"
end
function tr_back
if language==1; return "Назад"; else if language==2; return "戻る"; end; return "Back"
end
function tr_punch
if language==1; return "Удар"; else if language==2; return "攻撃"; end; return "Punch"
end
function tr_tap_to_return
if language==1; return "Нажмите, чтобы выйти"; else if language==2; return "タップして戻る"; end; return "Tap to return"
end
function tr_victory
if language==1; return "Победа!"; else if language==2; return "勝利!"; end; return "Victory!"
end
function tr_opponent_defeated
if language==1; return "Соперник побеждён"; else if language==2; return "相手を倒した"; end; return "Opponent defeated"
end
function tr_defeat
if language==1; return "Поражение"; else if language==2; return "敗北"; end; return "Defeat"
end
function tr_opponent_won
if language==1; return "Соперник победил"; else if language==2; return "相手の勝利"; end; return "The opponent won"
end
function tr_you_were_defeated
if language==1; return "Вы повержены"; else if language==2; return "倒されました"; end; return "You were defeated"
end
function tr_no_connection
if language==1; return "Нет соединения"; else if language==2; return "接続なし"; end; return "No connection"
end
function tr_connecting
if language==1; return "Подключение..."; else if language==2; return "接続中..."; end; return "Connecting..."
end
function tr_chat
if language==1; return "Чат"; else if language==2; return "チャット"; end; return "Chat"
end
function tr_online_chat
if language==1; return "Онлайн чат"; else if language==2; return "オンラインチャット"; end; return "Online chat"
end
function tr_no_messages
