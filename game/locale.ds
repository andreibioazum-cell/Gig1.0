end
function tr_close
if language==1; return "Закрыть"; else if language==2; return "閉じる"; end; return "Close"
end
function tr_type_message
if language==1; return "Введите сообщение..."; else if language==2; return "メッセージを入力..."; end; return "Type a message..."
end
function tr_send
if language==1; return "Отправить"; else if language==2; return "送信"; end; return "Send"
end
