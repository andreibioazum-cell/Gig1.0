// locale.ds — localized strings
//
// Every user-facing string goes through one of these tr_* helpers so the
// game can be translated without touching call sites. Each function picks
// the right language from the `language` global (0 English, 1 Russian,
// 2 Japanese) and returns the matching string.

// ---------------------------------------------------------------------------
// Main menu / settings
// ---------------------------------------------------------------------------
function tr_play
    if language==1
        return "Играть"
    else if language==2
        return "遊ぶ"
    end
    return "Play"
end

function tr_settings
    if language==1
        return "Настройки"
    else if language==2
        return "設定"
    end
    return "Settings"
end

