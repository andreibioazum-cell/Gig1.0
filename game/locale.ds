function tr_nick_ph
    if language==1
        return "Ник: 3-16 (буквы, цифры, _)"
    else if language==2
        return "ニック: 3-16モジ"
    end
    return "Nick: 3-16 (letters, digits, _)"
end

function tr_bad_nick
    if language==1
        return "Ник: 3-16 символов, только буквы, цифры и _"
    else if language==2
        return "ニック: 3-16モジ、エイスウジト_ノミ"
    end
    return "Nick: 3-16 chars, letters, digits and _ only"
end

// ---------------------------------------------------------------------------
// Settings toggles
// ---------------------------------------------------------------------------
// Japanese characters in this string used to render as "???" because the
// in-game font doesn't ship a Japanese glyph set, so the label is always
// the English phrase, regardless of the active language.
function tr_disco_epilepsy
    return "Epilepsy safe"
end

function tr_mode_on
    if language==1
