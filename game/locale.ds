function tr_buy_for num cost, str currency
// Единица валюты приходит в родительном падеже и со строчной буквы:
// «Купить за 100 леденцов», «Buy for 100 candies».
str out=""
if language==1; out="Купить за "+cost+" "+currency
else if language==2; out=cost+currency+"で買う"
else; out="Buy for "+cost+" "+currency; end
return out
end
