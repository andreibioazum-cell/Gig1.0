// menu.ds — main menu, classes screen and levels screen
//
// All screen flows other than the gameplay itself (lobby, mode picker,
// settings, classes, levels, login) live here. Touch and draw are
// split by screen via game_state checks in engine.ds.

// ---------------------------------------------------------------------------
// Helpers shared by multiple screens
// ---------------------------------------------------------------------------
// Returns the localized class name for the current player_class.
function class_name
    if player_class==1
        return tr_class_azum()
    end
    return tr_class_ordinary()
end

// Persist currency, class and unlocks. Also pushes the class to the
// network layer so any future online session uses the right skin.
function save_progress
    net_save_progress cups,player_class,azum_owned
    net_set_class player_class
end

// "Cups: N" indicator drawn in the top-right of the lobby/classes/levels
// screens.
function draw_cups
    str cup_s=tr_cups()+": "+cups
    num cw=text_ink_width(cup_s)*0.5
    text_scaled cup_s,screen_w-cw-20,18,0xFFD54A,0.5
end

// ---------------------------------------------------------------------------
// draw_lobby — the main menu
// ---------------------------------------------------------------------------
function draw_lobby
    rect 0,0,screen_w,screen_h,0x1a1a2e
    ctext "Cubic Battle 4",screen_h/2-150,0xFFFFFF

    // Main buttons: Play, Settings, Classes, Account. Classes sits
    // directly under Settings and uses the same size.
    num mx=(screen_w-btn_w)/2
    num my=screen_h/2-80
    button tr_play()    ,mx,my      ,btn_w,btn_h
    button tr_settings(),mx,my+80   ,btn_w,btn_h
    button tr_classes() ,mx,my+160  ,btn_w,btn_h
    button tr_account() ,mx,my+240  ,btn_w,btn_h

    if net_login_status()==2
        str ln=net_login_nick()
        if str_len(ln)>0
            str greet="Привет, \""+ln+"\""
            num lw=text_ink_width(greet)*0.5
            text_scaled greet,(screen_w-lw)/2,18,0xFFFFFF,0.5
        end
    end

    draw_cups
end

// ---------------------------------------------------------------------------
// draw_class_card — one card inside draw_classes
// ---------------------------------------------------------------------------
// Three states:
//   selected — currently chosen, shows "Selected".
//   locked   — Azum, but not yet purchased, shows the buy price.
//   default  — "Select" CTA.
function draw_class_card num x, num y, num w, num h, num cls, str title, str desc, str texname
    num sel=0
    num locked=0
    if player_class==cls
        sel=1
    end
    if cls==1&&azum_owned==0
        locked=1
        sel=0
    end

    // Highlight border for the currently selected card.
    if sel==1
        roundrect x-5,y-5,w+10,h+10,26,0xFF5A5A78
    end
    roundrect x,y,w,h,22,0xFF2A2A40

    // Sprite preview at the top of the card.
    num ts=2.2
    num spr=50*ts
    tex x+(w-spr)/2,y+28,texname,0,ts

    // Localized title and description, centered.
    num tw=text_ink_width(title)
    text title,x+(w-tw)/2,y+150,0xFFFFFF
    num dw=text_ink_width(desc)*0.5
    text_scaled desc,x+(w-dw)/2,y+198,0xC8C8E0,0.5

    // State-specific bottom button.
    if sel==1
        button_scaled tr_class_selected(),x+24,y+h-72,w-48,48,0.55
    else if locked==1
        button_scaled tr_class_buy()     ,x+24,y+h-72,w-48,48,0.55
    else
        button_scaled tr_class_pick()    ,x+24,y+h-72,w-48,48,0.55
    end
end

// ---------------------------------------------------------------------------
// draw_classes — class selection screen
// ---------------------------------------------------------------------------
function draw_classes
    rect 0,0,screen_w,screen_h,0x1a1a2e

    num cw=300
    num ch=300
    num gap=40
    num x1=(screen_w-cw*2-gap)/2
    num x2=x1+cw+gap
    num y=back_y+btn_h+16

    draw_class_card x1,y,cw,ch,0,tr_class_ordinary(),tr_class_ordinary_desc(),ORDINARY_TEX
    draw_class_card x2,y,cw,ch,1,tr_class_azum()    ,tr_class_azum_desc()    ,AZUM_TEX

    // "Levels" button sits below the Azum card.
    button_scaled tr_levels(),x2,y+ch+gap,cw,btn_h,0.9

    draw_cups
    if class_msg_t>0
        class_msg_t=class_msg_t-dt
        ctext tr_class_need_cups(),y+ch+gap+btn_h+18,0xFF8A80
    end
    draw_back
end

// ---------------------------------------------------------------------------
// pick_class — apply the user's class choice
// ---------------------------------------------------------------------------
// For Azum, if the user doesn't own it yet, try to buy it for
// azum_cost cups. If they can't afford it, show a hint and don't change
// the class. Otherwise just save and apply the choice.
function pick_class num cls
    if cls==1
        if azum_owned==0
            if cups>=azum_cost
                cups=cups-azum_cost
                azum_owned=1
                player_class=1
                save_progress
            else
                class_msg_t=2.5
            end
            return
        end
        player_class=1
        save_progress
        return
    end
    player_class=0
    save_progress
end

// ---------------------------------------------------------------------------
// touch_classes — input for the class selection screen
// ---------------------------------------------------------------------------
function touch_classes num x, num y, num action
    if action!=0
        return
    end
    if back_hit(x,y)==1
        start_transition 0
        return
    end

    num cw=300
    num ch=300
    num gap=40
    num x1=(screen_w-cw*2-gap)/2
    num x2=x1+cw+gap
    num cy=back_y+btn_h+16

    // Card row: tap inside each card to pick that class.
    if y>=cy&&y<=cy+ch
        if x>=x1&&x<=x1+cw
            pick_class 0
            return
        end
        if x>=x2&&x<=x2+cw
            pick_class 1
            return
        end
    end

    // "Levels" button under the Azum card.
    if y>=cy+ch+gap&&y<=cy+ch+gap+btn_h
        if x>=x2&&x<=x2+cw
            start_transition 9
            return
        end
    end
end

// ---------------------------------------------------------------------------
// draw_levels — level selection screen
// ---------------------------------------------------------------------------
// One row per level, each showing the level number and its damage absorb
// percentage. Currently read-only (the row is just tapped to select a
// level); a future "coming soon" gate would go here.
function draw_levels
    rect 0,0,screen_w,screen_h,0x1a1a2e
    ctext tr_levels(),back_y+btn_h+8,0xFFFFFF

    num n=1
    num row_h=78
    num y=back_y+btn_h+52
    num w=520
    num x=(screen_w-w)/2

    loop n<=max_level
        num sel=0
        if player_level==n
            sel=1
        end
        if sel==1
            roundrect x-4,y-4,w+8,row_h+8,24,0xFF5A5A78
        end
        roundrect x,y,w,row_h,20,0xFF2A2A40

        str title=tr_level()+" "+n
        str desc =tr_level_absorb()+" "+(n*10)+"%"
        num tw=text_ink_width(title)*0.7
        text_scaled title,x+(w-tw)/2,y+12,0xFFFFFF,0.7
        num dw=text_ink_width(desc)*0.5
        text_scaled desc ,x+(w-dw)/2,y+42,0xC8C8E0,0.5

        n=n+1
        y=y+row_h+10
    end

    draw_cups
    draw_back
end

// ---------------------------------------------------------------------------
// touch_levels — input for the level selection screen
// ---------------------------------------------------------------------------
function touch_levels num x, num y, num action
    if action!=0
        return
    end
    if back_hit(x,y)==1
        start_transition 8
        return
    end

    num n=1
    num row_h=78
    num ry=back_y+btn_h+52
    num w=520
    num rx=(screen_w-w)/2

    loop n<=max_level
        if x>=rx&&x<=rx+w&&y>=ry&&y<=ry+row_h
            player_level=n
            return
        end
        n=n+1
        ry=ry+row_h+10
    end
end

// ---------------------------------------------------------------------------
// draw_modes — Play -> Solo / Online + Epilepsy toggle
// ---------------------------------------------------------------------------
function draw_modes
    rect 0,0,screen_w,screen_h,0x1a1a2e
    button tr_solo()  ,(screen_w-btn_w)/2,screen_h/2-40 ,btn_w,btn_h
    button tr_online(),(screen_w-btn_w)/2,screen_h/2+40 ,btn_w,btn_h

    // Third button on the mode picker: epilepsy safety (turns the
    // disco flash off). Smaller text so the long label fits inside a
    // pill the same width as "Online".
    str lbl=tr_disco_epilepsy()+" ("+tr_mode_off()+")"
    if disco_safe==1
        lbl=tr_disco_epilepsy()+" ("+tr_mode_on()+")"
    end
    button_scaled lbl,(screen_w-btn_w)/2,screen_h/2+120,btn_w,btn_h,0.7

    draw_back
end

// ---------------------------------------------------------------------------
// draw_login — online login screen (nick only)
// ---------------------------------------------------------------------------
// The online screen asks ONLY for a nick; no password, no registration.
// The nick is persisted and silently restored on the next launch.
function draw_login
    rect 0,0,screen_w,screen_h,0x1a1a2e
    text tr_login_title(),24+login_ox,26,0xFFFFFF

    num bw=screen_w-120
    num bx=(screen_w-bw)/2+login_ox
    num fy=screen_h/2-60+login_oy
    text tr_nick(),bx+login_lab_ox,fy-login_lab,0xFFFFFF

    // Field background: highlight when focused so the user knows where
    // their typing will land.
    if login_field==1
        roundrect bx,fy,bw,login_fh,14,0xFF4B2E83
    else
        roundrect bx,fy,bw,login_fh,14,0xFF2A2A40
    end

    // Placeholder / cursor / actual text depending on the IME state.
    if str_len(login_nick)==0
        if keyboard_visible()==1
            text_in_field "|"           ,bx+16,fy,login_fh,0xFFFFFF,0.6
        else
            text_in_field tr_nick_ph()  ,bx+16,fy,login_fh,0x666688,0.6
        end
    else
        if keyboard_visible()==1
            text_in_field login_nick+"|",bx+16,fy,login_fh,0xFFFFFF,0.6
        else
            text_in_field login_nick    ,bx+16,fy,login_fh,0xFFFFFF,0.6
        end
    end

    num yb=fy+login_fh+40
    button tr_play(),(screen_w-btn_w)/2,yb,btn_w,btn_h

    num sy=yb+btn_h+34
    if login_status==5
        ctext tr_bad_nick(),sy,0xFF8A80
    end
    draw_back
end

// ---------------------------------------------------------------------------
// draw_settings — language picker
// ---------------------------------------------------------------------------
function draw_settings
    rect 0,0,screen_w,screen_h,0x1a1a2e
    num x=(screen_w-btn_w)/2
    num y=screen_h/2-110
    button "English",x,y     ,btn_w,btn_h
    button "Русский",x,y+80  ,btn_w,btn_h
    button "日本語"  ,x,y+160 ,btn_w,btn_h
    draw_back
end

// ---------------------------------------------------------------------------
// touch_lobby — main menu input
// ---------------------------------------------------------------------------
function touch_lobby num x, num y, num action
    if action!=0
        return
    end
    num mx=(screen_w-btn_w)/2
    num my=screen_h/2-80
    // Reject taps outside the button column.
    if x<mx-12||x>mx+btn_w+12
        return
    end
    if y>=my-8   &&y<=my+btn_h+8
        start_transition 2
        return
    end
    if y>=my+72  &&y<=my+btn_h+88
        start_transition 4
        return
    end
    if y>=my+152 &&y<=my+btn_h+168
        start_transition 8
        return
    end
    if y>=my+232 &&y<=my+btn_h+248
        login_after=0
        start_transition 7
    end
end

// ---------------------------------------------------------------------------
// login_focus — make sure the IME is open and the field is marked focused
// ---------------------------------------------------------------------------
// The nick field is the only field on this screen so it's always focused.
// If the system keyboard was just dismissed (e.g. user swiped it down)
// we reopen it without losing what was already typed: keyboard_show()
// re-uploads the current buffer to the system editor, so reopening does
// not reset the composing state.
function login_focus
    login_field=1
    if keyboard_visible()==1
        return
    end
    keyboard_show
end

// Initial entry: clear any leftover text (e.g. from chat) and open the
// keyboard so the user can start typing immediately.
function login_open
    login_field=1
    login_status=0
    login_nick=""
    keyboard_clear
    keyboard_show
end

// Attempt to commit the nick. Validation lives entirely in net_set_nick();
// no network call is required, the nick is just sanity-checked and
// persisted.
function login_do
    if net_set_nick(login_nick)==1
        login_status=0
        keyboard_hide
        keyboard_clear
        start_transition login_after
    else
        login_status=5
    end
end

// ---------------------------------------------------------------------------
// update_login — per-frame nick field maintenance
// ---------------------------------------------------------------------------
// Each frame we pull text from the keyboard buffer. A previous attempt
// compared against the previous buffer and ended up with an empty field
// when the pointer changed but the IME already had text in it.
function update_login
    if login_field!=1
        login_focus
    end
    login_nick=keyboard_get_text()
    if keyboard_enter_pressed()==1
        login_do
    end
end

// ---------------------------------------------------------------------------
// touch_login — login screen input
// ---------------------------------------------------------------------------
function touch_login num x, num y, num action
    if action!=0
        return
    end
    if back_hit(x,y)==1
        keyboard_hide
        keyboard_clear
        if login_after==5
            start_transition 2
        else
            start_transition 0
        end
        return
    end
    num bw=screen_w-120
    num bx=(screen_w-bw)/2+login_ox
    num fy=screen_h/2-60+login_oy
    num yb=fy+login_fh+40
    if x>=(screen_w-btn_w)/2-12&&x<=(screen_w-btn_w)/2+btn_w+12&&y>=yb-8&&y<=yb+btn_h+8
        login_do
        return
    end
    // Tap on the field (or anywhere outside the buttons) re-opens the
    // keyboard so the user can keep typing.
    login_focus
end

// ---------------------------------------------------------------------------
// touch_menu — generic input router for non-gameplay screens
// ---------------------------------------------------------------------------
function touch_menu num x, num y, num action
    if action!=0
        return
    end
    if game_state==7
        touch_login x,y,action
        return
    end
    if game_state==8
        touch_classes x,y,action
        return
    end
    if game_state==9
        touch_levels x,y,action
        return
    end
    if back_hit(x,y)==1
        start_transition 0
        return
    end

    num mx=(screen_w-btn_w)/2
    if x<mx-12||x>mx+btn_w+12
        return
    end

    if game_state==2
        // Mode picker: Solo / Online / Epilepsy toggle.
        if y>=screen_h/2-48&&y<=screen_h/2+32
            start_transition 1
            return
        end
        if y>=screen_h/2+32&&y<=screen_h/2+112
            if net_login_status()==2
                start_transition 5
            else
                login_after=5
                start_transition 7
            end
            return
        end
        if y>=screen_h/2+112&&y<=screen_h/2+192
            if disco_safe==1
                disco_safe=0
            else
                disco_safe=1
            end
            return
        end
    else if game_state==4
        // Language picker.
        num sy=screen_h/2-110
        if y>=sy-8&&y<sy+72
            language=0
        else if y>=sy+72&&y<sy+152
            language=1
        else if y>=sy+152&&y<sy+232
            language=2
        end
    end
end
