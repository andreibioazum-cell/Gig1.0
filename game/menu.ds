function is_admin_nick str n
// Статус администратора привязан к нику аккаунта, регистр не важен.
if str_len(n)==0; return 0; end
if str_ieq(n,ADMIN_NICK_1)==1; return 1; end
if str_ieq(n,ADMIN_NICK_2)==1; return 1; end
return 0
end
function is_admin
if net_login_status()!=2; return 0; end
return is_admin_nick(net_login_nick())
end
function class_name
if player_class==1; return tr_class_azum(); end
if player_class==2; return tr_class_santa(); end
return tr_class_ordinary()
end
function save_progress
net_save_progress cups,candies,player_class,azum_owned,santa_owned,player_level,levels_unlocked
net_set_class player_class
end
function level_cost num n
return level_base_cost+(n-1)*level_cost_step
end
function unlock_next_level num n
if n!=levels_unlocked+1; return; end
num cost=level_cost(n)
if cups<cost; level_msg_t=2.5; return; end
cups=cups-cost; levels_unlocked=n; player_level=n; level_msg_t=0; save_progress
end
function menu_top
return screen_h/2-120
end
function draw_money
str cup_s=tr_cups()+": "+cups
num cw=text_ink_width(cup_s)*0.5
text_scaled cup_s,screen_w-cw-20,18,0xFFFFFF,0.5
str cd_s=tr_candies()+": "+candies
num dw=text_ink_width(cd_s)*0.5
text_scaled cd_s,screen_w-dw-20,44,0xFFFFFF,0.5
end
function draw_lobby_money num y
str cup_s=tr_cups()+": "+cups, cd_s=tr_candies()+": "+candies
num cw=text_ink_width(cup_s)*0.5, dw=text_ink_width(cd_s)*0.5, gap=28
num x=(screen_w-cw-dw-gap)/2
text_scaled cup_s,x,y,0xFFFFFF,0.5
text_scaled cd_s,x+cw+gap,y,0xFFFFFF,0.5
end
function draw_lobby
num mx=(screen_w-btn_w)/2, my=menu_top()
rect 0,0,screen_w,screen_h,0x1a1a2e; ctext "Cubic Battle 4",my-70,0xFFFFFF
button tr_play(),mx,my,btn_w,btn_h;button tr_settings(),mx,my+80,btn_w,btn_h;button tr_shop(),mx,my+160,btn_w,btn_h;button tr_account(),mx,my+240,btn_w,btn_h
num money_y=my+240+btn_h+14
if is_admin()==1
button tr_admin(),mx,my+320,btn_w,btn_h
money_y=my+320+btn_h+14
end
if net_login_status()==2
str ln=net_login_nick()
if str_len(ln)>0
str greet=tr_hello()+", "+ln
num lw=text_ink_width(greet)*0.5
text_scaled greet,(screen_w-lw)/2,18,0xFFFFFF,0.5
if is_admin()==1
str st=tr_admin_status()
num sw=text_ink_width(st)*0.45
text_scaled st,(screen_w-sw)/2,44,0xFFD54A,0.45
end
end
end
draw_lobby_money money_y
end
function draw_class_card num x, num y, num w, num h, num cls, num owned, num cost, str title, str desc, str texname
num sel=0, locked=0
if player_class==cls; sel=1; end
if cls!=0&&owned==0; locked=1; sel=0; end
if sel==1; roundrect x-5,y-5,w+10,h+10,26,0xFF5A5A78; end
roundrect x,y,w,h,22,0xFF2A2A40
num ts=2.2, spr=50*ts
tex x+(w-spr)/2,y+28,texname,0,ts
num tw=text_ink_width(title)
text title,x+(w-tw)/2,y+150,0xFFFFFF
num dsc=text_fit_scale(desc,w-20,0.5)
num dw=text_ink_width(desc)*dsc
text_scaled desc,x+(w-dw)/2,y+198,0xC8C8E0,dsc
str cur=tr_cups_unit()
if cls==2; cur=tr_candies_unit(); end
if sel==1; button_scaled tr_class_selected(),x+24,y+h-72,w-48,48,0.55
else if locked==1; button_scaled tr_buy_for(cost,cur),x+24,y+h-72,w-48,48,0.55
else; button_scaled tr_class_pick(),x+24,y+h-72,w-48,48,0.55; end
end
function draw_classes
rect 0,0,screen_w,screen_h,0x1a1a2e
num cw=260, ch=300, gap=26
num total=cw*3+gap*2, x0=(screen_w-total)/2
num x1=x0, x2=x0+cw+gap, x3=x0+2*(cw+gap), y=back_y+btn_h+16
draw_class_card x1,y,cw,ch,0,1,0,tr_class_ordinary(),tr_class_ordinary_desc(),ORDINARY_TEX
draw_class_card x2,y,cw,ch,1,azum_owned,azum_cost,tr_class_azum(),tr_class_azum_desc(),AZUM_TEX
draw_class_card x3,y,cw,ch,2,santa_owned,santa_candy_cost,tr_class_santa(),tr_class_santa_desc(),SANTA_TEX
num by=y+ch+gap
button_scaled tr_levels(),(screen_w-btn_w)/2,by,btn_w,btn_h,0.9
draw_money
if class_msg_t>0
class_msg_t=class_msg_t-dt
str need=tr_class_need_cups()
if class_msg_kind==1; need=tr_class_need_candies(); end
ctext need,y+ch+gap+btn_h+44,0xFF8A80
end
draw_back
end
function pick_class num cls
if cls==0; player_class=0; save_progress; return; end
num owned=0
if cls==1; owned=azum_owned; end
if cls==2; owned=santa_owned; end
if owned==1; player_class=cls; save_progress; return; end
num bought=0
class_msg_kind=0
if cls==1
if cups>=azum_cost; cups=cups-azum_cost; azum_owned=1; bought=1; end
else
class_msg_kind=1
if candies>=santa_candy_cost; candies=candies-santa_candy_cost; santa_owned=1; bought=1; end
end
if bought==1; player_class=cls; save_progress; ds_log "bought class %g",cls
else; class_msg_t=2.5; end
end
function touch_classes num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; start_transition 0; return; end
num cw=260, ch=300, gap=26
num total=cw*3+gap*2, x0=(screen_w-total)/2
num x1=x0, x2=x0+cw+gap, x3=x0+2*(cw+gap), cy=back_y+btn_h+16
if y>=cy&&y<=cy+ch
if x>=x1&&x<=x1+cw; pick_class 0; return; end
if x>=x2&&x<=x2+cw; pick_class 1; return; end
if x>=x3&&x<=x3+cw; pick_class 2; return; end
end
num by=cy+ch+gap
if y>=by-8&&y<=by+btn_h+8
if x>=(screen_w-btn_w)/2-12&&x<=(screen_w+btn_w)/2+12; start_transition 9; return; end
end
end
function draw_levels
rect 0,0,screen_w,screen_h,0x1a1a2e
ctext tr_levels(),back_y+btn_h+8,0xFFFFFF
num n=1, row_h=78, y=back_y+btn_h+52, w=520, x=(screen_w-w)/2
loop n<=max_level
num unlocked=0, next=0
if n<=levels_unlocked; unlocked=1; end
if n==levels_unlocked+1; next=1; end
num sel=0; if player_level==n&&unlocked==1; sel=1; end
if sel==1; roundrect x-4,y-4,w+8,row_h+8,24,0xFF5A5A78; end
roundrect x,y,w,row_h,20,0xFF2A2A40
str title=tr_level()+" "+n
str desc=tr_level_absorb()+" "+(n*10)+"%"
if unlocked==0
if next==1; desc=tr_level_unlock()+" "+level_cost(n)+" "+tr_cups_unit()
else; desc=tr_level_locked(); end
end
num tw=text_ink_width(title)*0.7
text_scaled title,x+(w-tw)/2,y+12,0xFFFFFF,0.7
num dw=text_ink_width(desc)*0.5
col desc_c=0xC8C8E0
if unlocked==0; desc_c=0x8888AA; end
text_scaled desc,x+(w-dw)/2,y+42,desc_c,0.5
n=n+1; y=y+row_h+10
end
if level_msg_t>0; level_msg_t=level_msg_t-dt; ctext tr_level_need_cups(),back_y+btn_h+52+max_level*(row_h+10)+8,0xFF8A80; end
draw_money
draw_back
end
function touch_levels num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; start_transition 8; return; end
num n=1, row_h=78, ry=back_y+btn_h+52, w=520, rx=(screen_w-w)/2
loop n<=max_level
if x>=rx&&x<=rx+w&&y>=ry&&y<=ry+row_h
if n<=levels_unlocked; player_level=n; save_progress
else if n==levels_unlocked+1; unlock_next_level n; end
return
end
n=n+1; ry=ry+row_h+10
end
end
function draw_modes
rect 0,0,screen_w,screen_h,0x1a1a2e
num x=(screen_w-btn_w)/2, y=menu_top()
button tr_back(),x,y,btn_w,btn_h
button tr_solo(),x,y+80,btn_w,btn_h
button tr_online(),x,y+160,btn_w,btn_h
button tr_leaderboard(),x,y+240,btn_w,btn_h
end
function draw_login
rect 0,0,screen_w,screen_h,0x1a1a2e
text tr_login_title(),24+login_ox,26,0xFFFFFF
num bw=460, bx=(screen_w-bw)/2+login_ox, fy=screen_h/2-100+login_oy
text tr_nick(),bx+login_lab_ox,fy-login_lab,0xFFFFFF
roundrect bx,fy,bw,login_fh,14,0xFF2A2A40
if str_len(login_nick)==0; if keyboard_visible()==1&&login_field==1; text_in_field "|",bx+16,fy,login_fh,0xFFFFFF,0.6; else; text_in_field tr_nick_ph(),bx+16,fy,login_fh,0x666688,0.6; end; else; if keyboard_visible()==1&&login_field==1; text_in_field login_nick+"|",bx+16,fy,login_fh,0xFFFFFF,0.6; else; text_in_field login_nick,bx+16,fy,login_fh,0xFFFFFF,0.6; end; end
num py=fy+login_fh+36
text tr_pass(),bx+login_lab_ox,py-login_lab,0xFFFFFF
roundrect bx,py,bw,login_fh,14,0xFF2A2A40
if str_len(login_pass)==0; if keyboard_visible()==1&&login_field==2; text_in_field "|",bx+16,py,login_fh,0xFFFFFF,0.6; else; text_in_field tr_pass_ph(),bx+16,py,login_fh,0x666688,0.6; end; else; if keyboard_visible()==1&&login_field==2; text_in_field login_pass+"|",bx+16,py,login_fh,0xFFFFFF,0.6; else; text_in_field login_pass,bx+16,py,login_fh,0xFFFFFF,0.6; end; end
num yb=py+login_fh+34
button_scaled tr_login_btn(),(screen_w-380)/2,yb,380,btn_h,0.65
num sy=yb+btn_h+20
if login_status==5; ctext tr_bad_nick(),sy,0xFF8A80; end
if login_status==6; ctext tr_wrong_pass(),sy,0xFF8A80; end
if login_status==7; ctext tr_bad_pass(),sy,0xFF8A80; end
if login_status==4; ctext tr_no_connection(),sy,0xFF8A80; end
draw_back
end
function draw_settings
rect 0,0,screen_w,screen_h,0x1a1a2e
num x=(screen_w-btn_w)/2, y=menu_top()
button tr_back(),x,y,btn_w,btn_h
button "English",x,y+80,btn_w,btn_h
button "Русский",x,y+160,btn_w,btn_h
button "日本語",x,y+240,btn_w,btn_h
str lbl=tr_disco_epilepsy()+" ("+tr_mode_off()+")"
if disco_safe==1; lbl=tr_disco_epilepsy()+" ("+tr_mode_on()+")"; end
button_scaled lbl,x,y+320,btn_w,btn_h,0.7
end
function draw_leaderboard
rect 0,0,screen_w,screen_h,0x1a1a2e
ctext tr_leaderboard_title(),back_y+btn_h+12,0xFFFFFF
num st=net_leaderboard_status()
if st==1
ctext tr_loading(),screen_h/2,0xFFD54A
else if st==4
ctext tr_no_connection(),screen_h/2,0xFF8A80
else
num count=net_leaderboard_count()
if count==0
ctext tr_no_data(),screen_h/2,0x8888AA
else
num w=560, x=(screen_w-w)/2, y=back_y+btn_h+78, row_h=46, gap=8
num i=0
loop i<count
str rk="#"+(i+1), nk=net_leaderboard_nick(i)
if i==0; roundrect x,y,w,row_h,12,0xFF3D3215
else if i==1; roundrect x,y,w,row_h,12,0xFF2C3238
else if i==2; roundrect x,y,w,row_h,12,0xFF352620
else; roundrect x,y,w,row_h,12,0xFF2A2A40; end
col rank_c=0x9E9E9E
if i==0; rank_c=0xFFFFD700; else if i==1; rank_c=0xFFC0C0C0; else if i==2; rank_c=0xFFCD7F32; end
text_scaled rk,x+16,y+13,rank_c,0.6
text_scaled nk,x+70,y+13,0xE0E0FF,0.6
if is_admin_nick(nk)==1; text_scaled tr_admin(),x+70+text_ink_width(nk)*0.6+14,y+15,0xFFD54A,0.5; end
i=i+1; y=y+row_h+gap
end
end
end
draw_back
end
function touch_leaderboard num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; start_transition 2; return; end
end
function touch_lobby num x, num y, num action
if action!=0; return; end
num mx=(screen_w-btn_w)/2, my=menu_top()
if x<mx-12||x>mx+btn_w+12; return; end
if y>=my-8&&y<=my+btn_h+8; start_transition 2; return; end
if y>=my+72&&y<=my+btn_h+88; start_transition 4; return; end
if y>=my+152&&y<=my+btn_h+168; start_transition 8; return; end
if y>=my+232&&y<=my+btn_h+248; login_after=0; start_transition 7; return; end
if y>=my+312&&y<=my+btn_h+328&&is_admin()==1; start_transition 11; end
end
function login_sync_field
if keyboard_visible()==0; return; end
if login_field==1; login_nick=keyboard_get_text(); else; login_pass=keyboard_get_text(); end
end
function login_focus_nick
login_sync_field
login_field=1
keyboard_clear
if str_len(login_nick)>0; keyboard_type login_nick; end
keyboard_show
end
function login_focus_pass
login_sync_field
login_field=2
keyboard_clear
if str_len(login_pass)>0; keyboard_type login_pass; end
keyboard_show
end
function login_open
login_field=1; login_status=0; login_nick=""; login_pass=""
// Не открываем клавиатуру автоматически: она появляется только после тапа по полю.
keyboard_clear; keyboard_hide
end
function login_do
login_sync_field
if str_len(login_nick)==0; login_status=5; keyboard_hide; return; end
if str_len(login_pass)==0; login_status=7; keyboard_hide; return; end
num res=net_auth(FIREBASE,login_nick,login_pass)
if res==2
login_status=0; keyboard_hide; keyboard_clear
cups=net_load_cups(); candies=net_load_candies(); player_class=net_load_class(); azum_owned=net_load_azum(); santa_owned=net_load_santa(); player_level=net_load_level(); levels_unlocked=net_load_levels_unlocked()
if levels_unlocked<0; levels_unlocked=0; end
if levels_unlocked>max_level; levels_unlocked=max_level; end
if player_level<0||player_level>levels_unlocked; player_level=0; end
net_set_class player_class
start_transition login_after
else
login_status=res
end
end
function update_login
if keyboard_visible()==1; login_sync_field; end
if keyboard_enter_pressed()==1
if login_field==1; login_focus_pass; else; login_do; end
end
end
function touch_login num x, num y, num action
if action!=0; return; end
num bw=460, bx=(screen_w-bw)/2+login_ox, fy=screen_h/2-100+login_oy
num py=fy+login_fh+36
num yb=py+login_fh+34
if x>=bx&&x<=bx+bw&&y>=fy&&y<=fy+login_fh; login_focus_nick; return; end
if x>=bx&&x<=bx+bw&&y>=py&&y<=py+login_fh; login_focus_pass; return; end
if x>=(screen_w-380)/2-12&&x<=(screen_w+380)/2+12&&y>=yb-8&&y<=yb+btn_h+8; login_do; keyboard_hide; return; end
// Любой тап вне поля снимает фокус и закрывает IME, но не выбирает поле заново.
login_sync_field; keyboard_hide
if back_hit(x,y)==1; keyboard_clear; if login_after==5; start_transition 2; else; start_transition 0; end; end
end
function touch_menu num x, num y, num action
if action!=0; return; end
if game_state==7; touch_login x,y,action; return; end
if game_state==8; touch_classes x,y,action; return; end
if game_state==9; touch_levels x,y,action; return; end
if game_state==10; touch_leaderboard x,y,action; return; end
if game_state==11; touch_admin x,y,action; return; end
num mx=(screen_w-btn_w)/2, sy=menu_top()
if game_state==2||game_state==4
if x<mx-12||x>mx+btn_w+12; return; end
if y>=sy-8&&y<=sy+btn_h+8; start_transition 0; return; end
else
if back_hit(x,y)==1; start_transition 0; return; end
end
if x<mx-12||x>mx+btn_w+12; return; end
if game_state==2
if y>=sy+72&&y<=sy+btn_h+88; start_transition 1; return; end
if y>=sy+152&&y<=sy+btn_h+168
if net_login_status()==2; start_transition 5; else; login_after=5; start_transition 7; end
return
end
if y>=sy+232&&y<=sy+btn_h+248
net_leaderboard_fetch FIREBASE
start_transition 10; return
end
else if game_state==4
if y>=sy+72&&y<=sy+btn_h+88; language=0
else if y>=sy+152&&y<=sy+btn_h+168; language=1
else if y>=sy+232&&y<=sy+btn_h+248; language=2
else if y>=sy+312&&y<=sy+btn_h+328
if disco_safe==1; disco_safe=0; else; disco_safe=1; end
end
end
end
// ---------------------------------------------------------------------
// Админ-панель: список команд с поиском, как в консоли администратора.
// Открывается из лобби только у аккаунтов со статусом админа.
// ---------------------------------------------------------------------
function admin_cmd_slug num id
if id==0; return ";event disco"; end
if id==1; return ";event snow"; end
if id==2; return ";event off"; end
if id==3; return ";cups 100"; end
if id==4; return ";candies 100"; end
if id==5; return ";unlockClasses"; end
if id==6; return ";unlockLevels"; end
return ";resetProgress"
end
function admin_cmd_label num id
if id==0; return tr_event_disco(); end
if id==1; return tr_event_snow(); end
if id==2; return tr_event_stop(); end
if id==3; return tr_cmd_cups(); end
if id==4; return tr_cmd_candies(); end
if id==5; return tr_cmd_classes(); end
if id==6; return tr_cmd_levels(); end
return tr_cmd_reset()
end
function admin_cmd_desc num id
if id==0; return tr_event_disco_desc(); end
if id==1; return tr_event_snow_desc(); end
if id==2; return tr_event_stop_desc(); end
if id==3; return tr_cmd_cups_desc(); end
if id==4; return tr_cmd_candies_desc(); end
if id==5; return tr_cmd_classes_desc(); end
if id==6; return tr_cmd_levels_desc(); end
return tr_cmd_reset_desc()
end
function admin_cmd_color num id
if id==0; return 0xFFE040FB; end
if id==1; return 0xFF4FC3F7; end
if id==2; return 0xFFEF5350; end
if id==3; return 0xFFFFD54A; end
if id==4; return 0xFFFF7043; end
if id==5; return 0xFF66BB6A; end
if id==6; return 0xFF42A5F5; end
return 0xFF9E9E9E
end
function admin_cmd_match num id
// Поиск идёт и по названию, и по описанию, и по самой команде.
if str_len(admin_search)==0; return 1; end
if str_has(admin_cmd_label(id),admin_search)==1; return 1; end
if str_has(admin_cmd_slug(id),admin_search)==1; return 1; end
if str_has(admin_cmd_desc(id),admin_search)==1; return 1; end
return 0
end
function admin_match_count
num n=0, i=0
loop i<admin_cmd_count
if admin_cmd_match(i)==1; n=n+1; end
i=i+1
end
return n
end
function admin_visible_cmd num vi
num seen=0, i=0
loop i<admin_cmd_count
if admin_cmd_match(i)==1
if seen==vi; return i; end
seen=seen+1
end
i=i+1
end
return -1
end
function admin_panel_w
num w=620
if w>screen_w-40; w=screen_w-40; end
return w
end
function admin_panel_x
return (screen_w-admin_panel_w())/2
end
function admin_panel_y
return back_y+btn_h+12
end
function admin_head_h
return 52
end
function admin_row_h
return 44
end
// Ряд быстрых кнопок ивентов: «Диско», «Снег», «Выключить».
// Он всегда на виду и не зависит от поиска по командам.
function admin_quick_y
return admin_panel_y()+admin_head_h()+8
end
function admin_quick_h
return 44
end
function admin_quick_btn_w
return (admin_panel_w()-28-16)/3
end
function admin_quick_btn_x num i
return admin_panel_x()+14+i*(admin_quick_btn_w()+8)
end
function admin_quick_event num i
if i==0; return 1; end
if i==1; return 2; end
return 0
end
function admin_quick_label num i
if i==0; return tr_event_btn_disco(); end
if i==1; return tr_event_btn_snow(); end
return tr_event_btn_off()
end
function admin_quick_color num i
if i==0; return 0xFF7B1FA2; end
if i==1; return 0xFF0277BD; end
return 0xFFB71C1C
end
function admin_quick_color_on num i
if i==0; return 0xFFE040FB; end
if i==1; return 0xFF4FC3F7; end
return 0xFFEF5350
end
function admin_search_y
return admin_quick_y()+admin_quick_h()+8
end
function admin_search_h
return 40
end
function admin_status_y
return admin_search_y()+admin_search_h()+8
end
function admin_status_h
return 52
end
function admin_rows_y
return admin_status_y()+admin_status_h()+8
end
function admin_panel_h
if admin_min==1; return admin_head_h(); end
num rows=admin_match_count()
if rows==0; rows=1; end
num h=admin_head_h()+8+admin_quick_h()+8+admin_search_h()+8+admin_status_h()+8+rows*admin_row_h()+14
num maxh=screen_h-admin_panel_y()-16
if h>maxh; h=maxh; end
return h
end
function admin_rows_fit
num space=admin_panel_y()+admin_panel_h()-admin_rows_y()-14
num n=floor(space/admin_row_h())
if n<0; n=0; end
return n
end
function admin_say str msg
admin_msg=msg; admin_msg_t=2.5
end
function admin_open
admin_search=""; admin_msg=""; admin_msg_t=0; admin_min=0
keyboard_clear; keyboard_hide
net_event_fetch FIREBASE
end
function admin_set_event num ev
// Одна точка входа и для кнопок ивентов, и для команд списка.
if is_admin()==0; return; end
net_event_set FIREBASE,ev
if ev==1; admin_say tr_event_disco()
else if ev==2; admin_say tr_event_snow()
else; admin_say tr_event_none()
end
ds_log "admin event %g",ev
end
function admin_run num id
if is_admin()==0; return; end
if id==0; admin_set_event 1
else if id==1; admin_set_event 2
else if id==2; admin_set_event 0
else if id==3; cups=cups+100; save_progress; admin_say tr_cmd_cups()
else if id==4; candies=candies+100; save_progress; admin_say tr_cmd_candies()
else if id==5; azum_owned=1; santa_owned=1; save_progress; admin_say tr_cmd_classes()
else if id==6; levels_unlocked=max_level; save_progress; admin_say tr_cmd_levels()
else
cups=0; candies=0; azum_owned=0; santa_owned=0; player_class=0; player_level=0; levels_unlocked=0
save_progress; admin_say tr_cmd_reset()
end
ds_log "admin command %s",admin_cmd_slug(id)
end
function admin_event_name
num ev=net_event()
if ev==1; return tr_event_disco(); end
if ev==2; return tr_event_snow(); end
return tr_event_none()
end
function draw_admin_row num id, num x, num y, num w
roundrect x,y,w,admin_row_h()-6,12,0xFF2A2A40
roundrect x+14,y+13,14,14,4,admin_cmd_color(id)
text_scaled admin_cmd_label(id),x+40,y+6,0xFFFFFF,0.5
text_scaled admin_cmd_desc(id),x+40,y+26,0x9A9AB8,0.4
str slug=admin_cmd_slug(id)
num sw=text_ink_width(slug)*0.42
text_scaled slug,x+w-sw-16,y+14,0xC4A6FF,0.42
end
function draw_admin
rect 0,0,screen_w,screen_h,0x1a1a2e
num w=admin_panel_w(), x=admin_panel_x(), y=admin_panel_y(), h=admin_panel_h()
roundrect x,y,w,h,18,0xFF23233A
roundrect x,y,w,admin_head_h(),18,0x5F10A0
rect x,y+admin_head_h()-18,w,18,0x5F10A0
text_scaled tr_admin_panel(),x+18,y+14,0xFFFFFF,0.7
str ev=tr_event_state()+": "+admin_event_name()
num ew=text_ink_width(ev)*0.42
text_scaled ev,x+w-ew-118,y+20,0xFFE9A3,0.42
roundrect x+w-104,y+12,40,28,8,0xFF3E2A6E
text_in_box "-",x+w-104,y+12,40,28,0xFFFFFF,0.6
roundrect x+w-56,y+12,40,28,8,0xFFE94560
text_in_box "X",x+w-56,y+12,40,28,0xFFFFFF,0.6
if admin_min==1; return; end
// Три кнопки ивентов: включить диско, включить снег, выключить всё.
num qy=admin_quick_y(), qh=admin_quick_h(), qw=admin_quick_btn_w(), cur_ev=net_event(), qi=0
loop qi<3
num qx=admin_quick_btn_x(qi)
str ql=admin_quick_label(qi)
if admin_quick_event(qi)==cur_ev
roundrect qx,qy,qw,qh,12,admin_quick_color_on(qi)
roundrect qx+qw-22,qy+qh/2-5,10,10,5,0xFFFFFFFF
else
roundrect qx,qy,qw,qh,12,admin_quick_color(qi)
end
text_in_box ql,qx,qy,qw-18,qh,0xFFFFFF,text_fit_scale(ql,qw-44,0.55)
qi=qi+1
end
num sy=admin_search_y(), sh=admin_search_h()
roundrect x+14,sy,w-28,sh,12,0xFF191926
str shown=admin_search
if keyboard_visible()==1; shown=admin_search+"|"; end
if str_len(shown)==0; text_in_field tr_admin_search(),x+30,sy,sh,0x6E6E90,0.5
else; text_in_field shown,x+30,sy,sh,0xFFFFFF,0.5; end
if str_len(admin_search)>0; text_in_field "X",x+w-46,sy,sh,0x9A9AB8,0.5; end
num ty=admin_status_y(), th=admin_status_h()
roundrect x+14,ty,w-28,th,14,0xFF2F2F4A
roundrect x+28,ty+18,26,26,7,0xFFFFD54A
text_scaled tr_admin(),x+70,ty+10,0xFFFFFF,0.55
text_scaled tr_admin_unlock(),x+70,ty+34,0x9A9AB8,0.42
roundrect x+w-150,ty+16,120,30,10,0xFF2E7D32
text_in_box tr_admin_unlocked(),x+w-150,ty+16,120,30,0xFFFFFF,0.45
num ry=admin_rows_y(), rows=admin_match_count(), fit=admin_rows_fit()
if rows==0
text_scaled tr_admin_nothing(),x+30,ry+10,0x6E6E90,0.5
else
num vi=0
loop vi<rows
if vi>=fit; vi=rows
else
num id=admin_visible_cmd(vi)
if id>=0; draw_admin_row id,x+14,ry+vi*admin_row_h(),w-28; end
vi=vi+1
end
end
end
if admin_msg_t>0
str done=tr_admin_done()+": "+admin_msg
num dw=text_ink_width(done)*0.5
text_scaled done,(screen_w-dw)/2,y+h+10,0x7ED321,0.5
end
draw_back
end
function update_admin
if admin_msg_t>0; admin_msg_t=admin_msg_t-dt; if admin_msg_t<0; admin_msg_t=0; end; end
if keyboard_visible()==1; admin_search=keyboard_get_text(); end
end
function touch_admin num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; keyboard_hide; keyboard_clear; start_transition 0; return; end
num w=admin_panel_w(), px=admin_panel_x(), py=admin_panel_y()
if x>=px+w-104&&x<=px+w-64&&y>=py+12&&y<=py+40
if admin_min==1; admin_min=0; else; admin_min=1; keyboard_hide; end
return
end
if x>=px+w-56&&x<=px+w-16&&y>=py+12&&y<=py+40; keyboard_hide; keyboard_clear; start_transition 0; return; end
if admin_min==1; return; end
num qy=admin_quick_y(), qh=admin_quick_h(), qw=admin_quick_btn_w(), qi=0
loop qi<3
num qx=admin_quick_btn_x(qi)
if x>=qx&&x<=qx+qw&&y>=qy&&y<=qy+qh
keyboard_hide
admin_set_event admin_quick_event(qi)
return
end
qi=qi+1
end
num sy=admin_search_y(), sh=admin_search_h()
if x>=px+14&&x<=px+w-14&&y>=sy&&y<=sy+sh
if x>=px+w-56&&str_len(admin_search)>0
admin_search=""; keyboard_clear
else
if keyboard_visible()==0; keyboard_clear; if str_len(admin_search)>0; keyboard_type admin_search; end; keyboard_show; end
end
return
end
keyboard_hide
num ry=admin_rows_y(), rows=admin_match_count(), fit=admin_rows_fit()
if rows>fit; rows=fit; end
num vi=0
loop vi<rows
num ty=ry+vi*admin_row_h()
if x>=px+14&&x<=px+w-14&&y>=ty&&y<=ty+admin_row_h()-6
num id=admin_visible_cmd(vi)
if id>=0; admin_run id; end
return
end
vi=vi+1
end
end
